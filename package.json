{
  "name": "tabattack",
  "version": "3.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Jannes Meyer <jannes.meyer@gmail.com>",
  "repository": "https://github.com/JannesMeyer/TabAttack",
  "type": "module",
  "scripts": {
    "ts-watch": "tsc --watch",
    "check": "dprint check && tsc",
    "fmt": "dprint fmt",
    "bundle": "bun build --chunk-naming=[name].[ext] --external=chrome: --outdir=dist src/*.html src/background.ts",
    "start": "bun run bundle --watch",
    "build:firefox": "rm -rf firefox.xpi dist && git restore dist && NODE_ENV=production bun run bundle && TARGET=firefox bun src/manifest.ts && cd dist && bestzip ../firefox.xpi *",
    "build:chrome": "rm -rf chrome.zip dist && git restore dist && NODE_ENV=production bun run bundle && TARGET=chrome bun src/manifest.ts && cd dist && bestzip ../chrome.zip *",
    "up": "bun update && dprint config update"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "valtio": "2.3.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/chrome": "0.2.5",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bestzip": "3.0.2",
    "dprint": "0.55.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.2.14"
}
